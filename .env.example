# Copy to .env and fill in. Never commit .env.

# "Today" for quoting. The starter evals assume 2026-11-19.
MIRA_TODAY=2026-11-19

# Path to the supplied dataset (read-only). Leave empty to auto-detect
# data/ceylon-compass-dataset or ../ceylon-compass-dataset.
MIRA_DATASET_DIR=

# PostgreSQL (docker compose service "db")
DATABASE_URL=postgresql+psycopg://mira:mira@localhost:5433/mira

# Chat LLM. auto = DeepSeek when DEEPSEEK_API_KEY is set, else Gemini (or force: deepseek / gemini / ollama).
LLM_PROVIDER=auto
# Ollama: a model on this computer, no key (LLM_PROVIDER=ollama). Start Ollama and run
# "ollama pull qwen3:4b" first. docker compose points the backend at host.docker.internal.
OLLAMA_MODEL_FAST=qwen3:4b
OLLAMA_MODEL_STRONG=qwen3:4b
OLLAMA_MODEL_BACKUP=
# DeepSeek chat (platform.deepseek.com). Same model for fast and strong; backup optional.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FAST=deepseek-chat
DEEPSEEK_MODEL_STRONG=deepseek-chat
DEEPSEEK_MODEL_BACKUP=

# Gemini (Google AI Studio): always used for search embeddings, and for chat when the
# provider is gemini. Model names can be changed without code changes.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash
GEMINI_MODEL_BACKUP=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMS=768

# Langfuse tracing (optional; chat works without it)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match your Langfuse project region: EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com (a wrong host gives 401)
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: the project ID for trace links on the staff page (looked up once if empty)
LANGFUSE_PROJECT_ID=

# Pricing overrides for the live demo. Empty = use the workbook's Settings tab.
MIRA_MARGIN_DAY=
MIRA_MARGIN_MULTIDAY=

# Mock payments: 1 = every charge fails (demo the friendly failure). Test card 4000 0000 0000 0002 always fails.
MOCK_PAYMENT_FAIL=0

# Demo staff accounts (python -m app.db.seed, also run at startup). Set your own
# passwords; they are stored hashed. Empty password = that account is not created.
MIRA_STAFF_EMAIL=staff@ceylon-compass.example
MIRA_STAFF_PASSWORD=
MIRA_APPROVER_EMAIL=approver@ceylon-compass.example
MIRA_APPROVER_PASSWORD=
# Staff sign-in: hours a session lasts; set MIRA_COOKIE_SECURE=1 when served over HTTPS
MIRA_SESSION_HOURS=8
MIRA_COOKIE_SECURE=0

FRONTEND_ORIGIN=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
