# Copy to .env and fill in. Never commit .env.

# "Today" for quoting. The starter evals assume 2026-11-19.
MIRA_TODAY=2026-11-19

# Path to the supplied dataset (read-only). Leave empty to auto-detect
# data/ceylon-compass-dataset or ../ceylon-compass-dataset.
MIRA_DATASET_DIR=

# PostgreSQL (docker compose service "db")
DATABASE_URL=postgresql+psycopg://mira:mira@localhost:5433/mira

# Gemini (Google AI Studio). Model names can be changed without code changes.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Langfuse tracing (optional; chat works without it)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Pricing overrides for the live demo. Empty = use the workbook's Settings tab.
MIRA_MARGIN_DAY=
MIRA_MARGIN_MULTIDAY=

FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
